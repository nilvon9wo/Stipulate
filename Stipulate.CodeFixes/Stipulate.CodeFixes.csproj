<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Code fixes for Stipulate.Analyzers' diagnostics. They need the Workspaces API, which
    the compiler doesn't provide, so they're kept out of the analyzer assembly (RS1038).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Stipulate.Analyzers\RestateProperties.cs" Link="Linked\RestateProperties.cs" />
    <Compile Include="..\Stipulate.Analyzers\DiagnosticIds.cs" Link="Linked\DiagnosticIds.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests exercise the internal collaborators directly. Internal, so no consumer sees them. -->
    <InternalsVisibleTo Include="Net.NowhereAtAll.Stipulate.CodeFixes.Test" />
  </ItemGroup>

</Project>
