<Project>

  <!--
    Without EnforceCodeStyleInBuild, the error-severity IDE0xxx rules in .editorconfig are
    enforced only by an IDE's live analysis (or `dotnet format`), never by `dotnet build` or CI.
    Everything is an error (docs/contribute/coding-standards.md), the compiler's and NuGet's own
    warnings included. LangVersion is pinned once so the netstandard2.0 projects compile with
    the same modern syntax as the net10.0 ones.
  -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Enforce DataAnnotations validation attributes on method parameters. Two interchangeable approaches:

      Weaving       (default) After each project compiles, ParameterValidation.Weaver rewrites the
                    assembly's IL so every attributed method validates its own arguments.
                    See Directory.Build.targets.
      Interceptors  ParameterValidation.Generator intercepts each call site at compile time, so
                    only callers built in this folder are validated.
      None          No enforcement.

    Override per build with e.g. -p:ParameterValidationMode=Interceptors.
  -->
  <PropertyGroup>
    <ParameterValidationMode Condition="'$(ParameterValidationMode)' == ''">Weaving</ParameterValidationMode>
    <IsParameterValidationTool Condition="$(MSBuildProjectName.StartsWith('ParameterValidation.'))">true</IsParameterValidationTool>
  </PropertyGroup>

  <!--
    Whatever the mode, ParameterValidation.Analyzers checks that implementations and overrides
    don't strengthen their contract's preconditions or weaken its guarantees (PV1001-PV1003), live
    in the IDE and in the build; ParameterValidation.CodeFixes offers to restate a missing attribute.
    ParameterValidation.Contracts provides [ComparableValidation], which describes a custom
    validation attribute so the analyzer can compare it.

    Assemblies whose files are under ParameterValidationSolutionRoot count as part of the
    solution: an attribute declared in one that can't be compared is reported as PV2001 ("add a
    [ComparableValidation]") rather than PV2002 ("it's someone else's; describe it from your
    assembly").
  -->
  <PropertyGroup>
    <ParameterValidationSolutionRoot Condition="'$(ParameterValidationSolutionRoot)' == ''">$(MSBuildThisFileDirectory)</ParameterValidationSolutionRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsParameterValidationTool)' != 'true'">
    <CompilerVisibleProperty Include="ParameterValidationSolutionRoot" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)ParameterValidation.Contracts\ParameterValidation.Contracts.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)ParameterValidation.Analyzers\ParameterValidation.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- Its code fixes (lightbulbs) only run in the IDE; the compiler ignores them. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)ParameterValidation.CodeFixes\ParameterValidation.CodeFixes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup Condition="'$(ParameterValidationMode)' == 'Interceptors' And '$(IsParameterValidationTool)' != 'true'">
    <InterceptorsNamespaces>$(InterceptorsNamespaces);ParameterValidation.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup Condition="'$(ParameterValidationMode)' == 'Interceptors' And '$(IsParameterValidationTool)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)ParameterValidation.Generator\ParameterValidation.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Build-order only: the weaver must be built before any project it rewrites. -->
  <ItemGroup Condition="'$(ParameterValidationMode)' == 'Weaving' And '$(IsParameterValidationTool)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)ParameterValidation.Weaver\ParameterValidation.Weaver.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

</Project>
