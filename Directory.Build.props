<Project>

  <!--
    Without EnforceCodeStyleInBuild, the error-severity IDE0xxx rules in .editorconfig are
    enforced only by an IDE's live analysis (or `dotnet format`), never by `dotnet build` or CI.
    Everything is an error (docs/contribute/coding-standards.md), the compiler's and NuGet's own
    warnings included. LangVersion is pinned once so the netstandard2.0 projects compile with
    the same modern syntax as the net10.0 ones.
  -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Like XFTY, every Stipulate assembly and namespace lives under Net.NowhereAtAll, so
    Stipulate.Weaver builds Net.NowhereAtAll.Stipulate.Weaver.dll; the folders,
    projects and (later) package IDs keep the short name.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Stipulate.'))">
    <AssemblyName>Net.NowhereAtAll.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Net.NowhereAtAll.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <!--
    Coverage is not an optional extra: every `dotnet test` of a Stipulate.*.Test
    project, local or CI, measures the one package that project tests and fails below 100% line
    AND branch coverage (docs/contribute/coverage-standards.md).

    - coverlet.MTP, not coverlet.collector: global.json selects the Microsoft Testing Platform
      runner, under which coverlet.collector silently measures nothing.
    - The include filter is derived from the project name (Stipulate.Weaver.Test
      measures Net.NowhereAtAll.Stipulate.Weaver), so neither the test assembly, the
      shared Stipulate.Testing helpers nor xunit's own DLLs drag the numbers down.
    - The exclude filter must be given explicitly. Left to its default, coverlet.MTP excludes every
      assembly loaded alongside the tests, cut to its first two name segments: one
      Net.NowhereAtAll.Stipulate.* assembly becomes [Net.NowhereAtAll.*]*, which excludes
      the measured assembly too, and the threshold then fails on "No coverable data".
    - Stipulate.Integration.Test builds a consumer project with `dotnet build`; it
      measures no one assembly, so it is not measured.
    - Running a filtered subset (one class, say) cannot reach 100%: pass
      `-p:StipulateCoverage=false` to `dotnet test` for those runs.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Stipulate.')) And $(MSBuildProjectName.EndsWith('.Test')) And '$(MSBuildProjectName)' != 'Stipulate.Integration.Test'">
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <StipulateCoverage Condition="'$(StipulateCoverage)' == ''">true</StipulateCoverage>
    <StipulateCoveredAssembly>Net.NowhereAtAll.$(MSBuildProjectName.Substring(0, $(MSBuildProjectName.LastIndexOf('.Test'))))</StipulateCoveredAssembly>
  </PropertyGroup>
  <PropertyGroup Condition="'$(StipulateCoverage)' == 'true' And '$(StipulateCoveredAssembly)' != ''">
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --coverlet --coverlet-include "[$(StipulateCoveredAssembly)]*" --coverlet-exclude "[Net.NowhereAtAll.Stipulate.Testing]*" --coverlet-output-format cobertura --coverlet-threshold 100 --coverlet-threshold-type line --coverlet-threshold-type branch</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <ItemGroup Condition="'$(StipulateCoveredAssembly)' != ''">
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>

  <!--
    The version of a local build, as XFTY does it: an obviously-not-a-release 0.0.0-dev. A release's
    version is the newest `## [x.y.z]` heading in CHANGELOG.md, which publish.yml stamps in at pack
    time; it is never edited here. See docs/contribute/packaging.md.
  -->
  <PropertyGroup>
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <!--
    Every project here that isn't one of Stipulate's own (ArrayFoo, its tests, a consumer the
    integration tests build) uses Stipulate as a package consumer would, but from this repository's
    projects: the analyzer and code fix, Stipulate.Contracts, and the build integration the package
    ships, Stipulate.Package/buildTransitive/Stipulate.targets, imported by Directory.Build.targets. Choose
    the enforcement with StipulateMode (Weaving, Interceptors or None); see that file.

    The whole repository counts as the solution, for ST2001 against ST2002.
  -->
  <PropertyGroup>
    <IsStipulateTool Condition="$(MSBuildProjectName.StartsWith('Stipulate.'))">true</IsStipulateTool>
    <StipulateSolutionRoot Condition="'$(StipulateSolutionRoot)' == ''">$(MSBuildThisFileDirectory)</StipulateSolutionRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsStipulateTool)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Stipulate.Contracts\Stipulate.Contracts.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Stipulate.Analyzers\Stipulate.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- Its code fixes (lightbulbs) only run in the IDE; the compiler ignores them. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)Stipulate.CodeFixes\Stipulate.CodeFixes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Item conditions see every property's final value, the defaults Stipulate.targets sets included,
    so these can test StipulateMode here.
  -->
  <ItemGroup Condition="'$(StipulateMode)' == 'Interceptors' And '$(IsStipulateTool)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Stipulate.Generator\Stipulate.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Build-order only: the weaver must be built before any project it rewrites. -->
  <ItemGroup Condition="'$(StipulateMode)' == 'Weaving' And '$(IsStipulateTool)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Stipulate.Weaver\Stipulate.Weaver.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

</Project>
